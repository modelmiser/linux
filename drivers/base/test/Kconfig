config TEST_ASYNC_DRIVER_PROBE
	tristate "Build kernel module to test asynchronous driver probing"
	depends on m
	help
	  Enabling this option produces a kernel module that allows
	  testing asynchronous driver probing by the device core.
	  The module name will be test_async_driver_probe.ko

	  If unsure say N.

config DM_KUNIT_TEST
	tristate "KUnit Tests for the device model" if !KUNIT_ALL_TESTS
	depends on KUNIT
	default KUNIT_ALL_TESTS

config DRIVER_PE_KUNIT_TEST
	tristate "KUnit Tests for property entry API" if !KUNIT_ALL_TESTS
	depends on KUNIT
	default KUNIT_ALL_TESTS

config DRIVER_SWNODE_KUNIT_TEST
	tristate "KUnit Tests for software node fw_devlink links" if !KUNIT_ALL_TESTS
	depends on KUNIT
	default KUNIT_ALL_TESTS

config DEVM_REFS_TEST
	tristate "Test driver for DEBUG_DEVRES_REFS"
	depends on DEBUG_DEVRES_REFS
	help
	  Registers a platform device whose driver exposes /dev/devm_refs_bad
	  (state in devm memory, freed on unbind while open) and
	  /dev/devm_refs_good (refcounted state). Unbinding with both nodes
	  open must warn exactly once. See drivers/base/test/devm_refs_test.c.

	  If unsure say N.

config DEVM_REFS_LA_GLUE
	bool "Instantiate gpio-sloppy-logic-analyzer on a fake GPIO chip (DEBUG_DEVRES_REFS test)"
	depends on DEBUG_DEVRES_REFS && GPIOLIB && GPIO_SLOPPY_LOGIC_ANALYZER=y
	help
	  Registers a platform device for the sloppy logic analyzer bound to
	  lines 0 and 1 of a built-in fake non-sleeping GPIO chip, so the
	  analyzer can be unbound with its debugfs files open in a VM.

	  If unsure say N.

config DEVM_REFS_V4L2_TEST
	tristate "V4L2-shaped test driver for DEBUG_DEVRES_REFS"
	depends on DEBUG_DEVRES_REFS && VIDEO_DEV
	help
	  Registers a platform device whose driver embeds its video_device in
	  a devm allocation, as cx231xx does. Unbinding with the video node
	  open must warn once via the V4L2 holder hook, and closing the node
	  afterwards is a use-after-free. See
	  drivers/base/test/devm_refs_v4l2_test.c.

	  If unsure say N.
